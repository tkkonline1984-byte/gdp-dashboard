# Copy these values to Streamlit Community Cloud > App settings > Secrets.
# Never commit a real token or real passwords to GitHub.

APP_ACCESS_CODE = "CHANGE-EMPLOYEE-CODE"
ADMIN_CODE = "CHANGE-ADMIN-CODE"

STORAGE_MODE = "local"
GITHUB_REPOSITORY = ""
GITHUB_BRANCH = "main"
GITHUB_DATA_ROOT = "submissions"
GITHUB_TOKEN = ""

# Keep false. Public storage is blocked to protect employee and company data.
ALLOW_PUBLIC_STORAGE = false

# true checks the real EAN-13 check digit; false checks only that there are 13 digits.
STRICT_EAN13 = true
